    connText: document.getElementById("connText"),
    capacityMain: document.getElementById("capacityMain"),
    fillMain: document.getElementById("fillMain"),
    fillAnim: document.getElementById("fillAnim"),
    grainWeight: document.getElementById("grainWeight"),
    tempMain: document.getElementById("tempMain"),
    humMain: document.getElementById("humMain"),
    statusBox: document.getElementById("statusBox"),
    fireMain: document.getElementById("fireMain"),
    fireAlert: document.getElementById("fireAlert"),
    aiSummary: document.getElementById("aiSummary"),
    healthScore: document.getElementById("healthScore"),
    healthBar: document.getElementById("healthBar"),
    alertCount: document.getElementById("alertCount"),
    lastAlert: document.getElementById("lastAlert")
  };

  const popupContainer = document.getElementById("popupContainer");
  const chartContainer = document.getElementById("chartContainer");

  function showPopup(msg, type="safe") {
    const p = document.createElement("div");
    p.className = `popup ${type}`;
    p.textContent = msg;
    popupContainer.appendChild(p);
    setTimeout(()=>{p.style.opacity="0"; setTimeout(()=>p.remove(),400)},5000);
  }

  // --- FIXED SIZE CHART ---
  const ctx = document.getElementById("chartMain");
  const chart = new Chart(ctx, {
    type: "line",
    data: { labels: [], datasets: [
      { label: "🌡 Temp (°C)", borderColor:"#ef4444", data:[], borderWidth:2, tension:0.3, pointRadius:0 },
      { label: "💧 Humidity (%)", borderColor:"#3b82f6", data:[], borderWidth:2, tension:0.3, pointRadius:0 },
      { label: "📦 Capacity (%)", borderColor:"#22c55e", data:[], borderWidth:2, tension:0.3, pointRadius:0 }
    ]},
    options: {
      responsive:true,
      maintainAspectRatio:false,
      animation:false,
      scales:{ 
        x:{ ticks:{ maxTicksLimit:6, color:"#374151" }, grid:{ display:false }},
        y:{ beginAtZero:true, max:100, grid:{ color:"#f3f4f6" }}
      },
      plugins:{ legend:{ position:"bottom" } }
    }
  });

  let fireCount = 0;

  async function fetchData() {
    try {
      const res = await fetch(API_URL);
      const json = await res.json();
      refs.connText.textContent = "Connected ✅";
      const d = json.esp;
      if (!d) return;

      refs.capacityMain.textContent = `${d.capacity_pct}%`;
      refs.fillMain.style.width = `${d.capacity_pct}%`;
      refs.fillAnim.style.width = `${d.capacity_pct}%`;

      const density = parseFloat(document.querySelector("#grainType option:checked").dataset.density);
      refs.grainWeight.textContent = `${((d.capacity_pct/100)*1000*density).toFixed(1)} kg`;

      refs.tempMain.textContent = `${d.temperature.toFixed(1)} °C`;
      refs.humMain.textContent = `${d.humidity.toFixed(0)} %`;

      // 🔥 Fire Alerts
      if (d.fire_detected == 1) {
        document.body.classList.add("danger-mode");
        chartContainer.classList.add("danger");
        refs.fireMain.textContent = "🔥 Detected";
        refs.fireAlert.style.display = "block";
        showPopup("🔥 Fire detected in warehouse!", "danger");
      } else {
        document.body.classList.remove("danger-mode");
        chartContainer.classList.remove("danger");
        refs.fireMain.textContent = "Safe";
        refs.fireAlert.style.display = "none";
      }

      // 🧠 Health Score
      const health = Math.max(0, 100 - Math.abs(d.temperature-28)*2 - Math.abs(d.humidity-60) - (d.fire_detected?50:0));
      refs.healthScore.textContent = `${health.toFixed(1)}%`;
      refs.healthBar.style.width = `${health}%`;
      refs.statusBox.textContent = health>80?"Ideal":(health>50?"Warning":"Critical");

      if (health < 50) {
        chartContainer.classList.add("danger");
        document.body.classList.add("danger-mode");
        showPopup("🚨 Warehouse Health Critical!", "danger");
      } else {
        chartContainer.classList.remove("danger");
      }

      // 📊 Update Chart with Cap
      const now = new Date().toLocaleTimeString('en-IN',{hour12:false});
      chart.data.labels.push(now);
      chart.data.datasets[0].data.push(d.temperature);
      chart.data.datasets[1].data.push(d.humidity);
      chart.data.datasets[2].data.push(d.capacity_pct);

      const MAX_POINTS = 20;
      if(chart.data.labels.length > MAX_POINTS){
        chart.data.labels.splice(0, chart.data.labels.length - MAX_POINTS);
        chart.data.datasets.forEach(ds => ds.data.splice(0, ds.data.length - MAX_POINTS));
      }

      chart.update("none");

    } catch (err) {
      refs.connText.textContent = "Offline ❌";
    }
  }

  fetchData();
  setInterval(fetchData, 8000);
});
</script>
