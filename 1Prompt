<script>
document.addEventListener("DOMContentLoaded", () => {
  // ---------- CONFIG ----------
  const WEATHER_KEY = "1009a9b3a995454c80073905250911";
  const WEATHER_API = "https://api.weatherapi.com/v1/current.json";
  const ESP_API = "http://10.21.181.29/sensors";     // <-- your ESP endpoint (direct)
  const MARKET_API = "market_api.php";

  // ---------- REFS ----------
  const refs = {
    connText: document.getElementById("connText"),
    weatherLocation: document.getElementById("weatherLocation"),
    weatherTemp: document.getElementById("weatherTemp"),
    weatherHum: document.getElementById("weatherHum"),
    weatherCond: document.getElementById("weatherCond"),
    weatherWind: document.getElementById("weatherWind"),
    weatherPressure: document.getElementById("weatherPressure"),
    weatherAQI: document.getElementById("weatherAQI"),
    weatherIcon: document.getElementById("weatherIcon"),
    fieldMoistMain: document.getElementById("fieldMoistMain"),
    motorMain: document.getElementById("motorMain"),
    cropMain: document.getElementById("cropMain"),
    capacityMain: document.getElementById("capacityMain"),
    fireMain: document.getElementById("fireMain"),
    healthMain: document.getElementById("healthMain"),
    mandiName: document.getElementById("mandiName"),
    topCrop: document.getElementById("topCrop"),
    marketTime: document.getElementById("marketTime"),
    schemeList: document.getElementById("schemeList")
  };

  // ---------- Weather ----------
  function getWeather(lat, lon) {
    fetch(`${WEATHER_API}?key=${WEATHER_KEY}&q=${lat},${lon}&aqi=yes`)
      .then(r => r.json())
      .then(data => {
        if (!data || !data.current) throw new Error("No weather data");
        const c = data.current, loc = data.location;
        refs.weatherLocation.textContent = `${loc.name}, ${loc.region || loc.country || ""}`;
        refs.weatherTemp.textContent = `${c.temp_c} °C`;
        refs.weatherHum.textContent = `${c.humidity} %`;
        refs.weatherCond.textContent = c.condition.text;
        refs.weatherWind.textContent = `${c.wind_kph} km/h`;
        refs.weatherPressure.textContent = `${c.pressure_mb}`;
        refs.weatherAQI.textContent = (c.air_quality && c.air_quality.pm2_5) ? c.air_quality.pm2_5.toFixed(1) : "N/A";
        refs.weatherIcon.src = c.condition.icon ? ("https:" + c.condition.icon) : "";
      })
      .catch(() => refs.weatherLocation.textContent = "⚠️ Weather API Error");
  }

  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(pos => {
      getWeather(pos.coords.latitude, pos.coords.longitude);
    }, () => {
      // fallback
      getWeather("Ranchi", "Jharkhand");
    });
  } else getWeather("Ranchi", "Jharkhand");

  // ---------- Helper: fetch with timeout ----------
  async function fetchWithTimeout(url, opts = {}, timeout = 2500) {
    const controller = new AbortController();
    const id = setTimeout(() => controller.abort(), timeout);
    try {
      const resp = await fetch(url, { signal: controller.signal, ...opts, cache: "no-store" });
      clearTimeout(id);
      return resp;
    } finally {
      clearTimeout(id);
    }
  }

  // ---------- ESP Reachability + Data loader ----------
  async function checkESPReachable() {
    try {
      // Lightweight check: try GET the sensors endpoint
      const r = await fetchWithTimeout(ESP_API + "?_ts=" + Date.now(), { method: "GET" }, 1800);
      if (!r.ok) throw new Error("not ok");
      // we won't parse large body here; presence of OK is enough
      refs.connText.textContent = "Connected ✅";
      refs.connText.classList.remove("small-muted");
      return true;
    } catch (e) {
      refs.connText.textContent = "Offline ❌";
      refs.connText.classList.add("small-muted");
      return false;
    }
  }

  async function loadESPData() {
    try {
      const r = await fetchWithTimeout(ESP_API + "?_ts=" + Date.now(), { method: "GET" }, 3000);
      if (!r.ok) throw new Error("ESP fetch failed");
      const raw = await r.json();

      // Accept either { esp: {...} } or direct {...}
      const d = raw.esp ? raw.esp : raw;

      // Defensive checks & fill UI
      if (d) {
        refs.fieldMoistMain.textContent = (d.moisture_pct ?? d.moisture ?? d.moist ?? "--") + (typeof d.moisture_pct === "number" ? "%" : "");
        refs.motorMain.textContent = (typeof d.motor_on === "boolean") ? (d.motor_on ? "ON" : "OFF") : (d.motor ?? d.motor_on ?? "--");
        refs.cropMain.textContent = d.crop || d.crop_name || "—";

        refs.capacityMain.textContent = (d.capacity_pct ?? d.storage_capacity ?? "--") + (typeof d.capacity_pct === "number" ? "%" : "");
        refs.fireMain.textContent = (d.fire_detected || d.fire) ? "🔥 Fire" : "Safe";

        // Health score simple calc
        const temp = (d.temperature ?? d.temp ?? null);
        const hum = (d.humidity ?? d.hum ?? null);
        if (typeof temp === "number" && typeof hum === "number") {
          const health = Math.max(0, 100 - Math.abs(temp - 28)*2 - Math.abs(hum - 60));
          refs.healthMain.textContent = `${Math.round(health)}%`;
        } else {
          refs.healthMain.textContent = "--%";
        }
      }
    } catch (err) {
      // leave the UI values as-is or show offline markers
      refs.fieldMoistMain.textContent = "--%";
      refs.motorMain.textContent = "--";
      refs.cropMain.textContent = "--";
      refs.capacityMain.textContent = "--%";
      refs.fireMain.textContent = "Offline";
      console.warn("loadESPData error:", err);
    }
  }

  // Combined check+load
  async function refreshESPStatusAndData() {
    const ok = await checkESPReachable();
    if (ok) await loadESPData();
  }

  // ---------- Market quick summary (for index card) ----------
  async function loadMarketSummary() {
    try {
      const district = localStorage.getItem("user_district") || "Ranchi";
      const state = "Jharkhand";
      const res = await fetchWithTimeout(`${MARKET_API}?state=${encodeURIComponent(state)}&district=${encodeURIComponent(district)}&_ts=${Date.now()}`, {}, 4000);
      if (!res.ok) throw new Error("market fetch failed");
      const data = await res.json();

      // Normalize expected fields
      const mandi = (data.mandis && data.mandis.length) ? data.mandis[0] : (data.mandi || null);
      if (mandi) {
        refs.mandiName.textContent = `${mandi.name}, ${mandi.district || district}`;
        const crop = data.commodities?.grains?.[0] || (data.commodities && data.commodities[0]) || null;
        refs.topCrop.textContent = crop ? `${crop.name}: ₹${crop.price}${crop.unit ? `/${crop.unit}` : ""}` : "--";
        refs.marketTime.textContent = new Date().toLocaleTimeString();
      } else {
        refs.mandiName.textContent = "No data";
        refs.topCrop.textContent = "--";
      }
    } catch (e) {
      refs.mandiName.textContent = "Error fetching data";
      refs.topCrop.textContent = "--";
    }
  }

  // ---------- Schemes (static quick list) ----------
  function loadSchemes() {
    refs.schemeList.innerHTML = `
      <li><strong>PM Kisan Samman Nidhi:</strong> ₹6,000 annual support — <a href="https://pmkisan.gov.in/" target="_blank">Visit</a></li>
      <li><strong>PM Fasal Bima Yojana:</strong> Crop insurance scheme — <a href="https://pmfby.gov.in/" target="_blank">Visit</a></li>
      <li><strong>Kisan Credit Card:</strong> Easy farm loan access — <a href="https://www.nabard.org/" target="_blank">Visit</a></li>
      <li><strong>eNAM Market:</strong> National online agri-market — <a href="https://enam.gov.in/web/" target="_blank">Visit</a></li>
      <li><strong>Soil Health Card:</strong> Free soil testing program — <a href="https://soilhealth.dac.gov.in/" target="_blank">Visit</a></li>
    `;
  }

  // ---------- Initial load & periodic refresh ----------
  async function doInitialLoads() {
    loadSchemes();
    await refreshESPStatusAndData();
    loadMarketSummary();
  }

  doInitialLoads();

  // refresh often but not too often
  setInterval(() => {
    refreshESPStatusAndData();
    loadMarketSummary();
  }, 10000);

});
</script>

