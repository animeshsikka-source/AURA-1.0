

/************************************************************
   🌾 AURA — ESP8266 Unified Sensor Node (with fallback values)
   OUTPUT EXACT FORMAT REQUIRED BY YOUR DASHBOARD
*************************************************************/

#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <ArduinoJson.h>
#include <DHT.h>

#define DHTTYPE DHT11

// ------------ SENSOR PINS -------------
#define DHT_FIELD_PIN    D4
#define DHT_WARE_PIN     D5
#define SOIL_PIN         A0
#define FIRE_PIN         D6
#define TRIG_PIN         D1
#define ECHO_PIN         D2

// ------------ MOTOR CONTROL ----------
#define MOTOR_PIN    D3
int motorHP = -1;
bool motorState = false;

// ------------ WIFI --------------------
const char* ssid = "YOUR_WIFI";
const char* password = "YOUR_PASS";

ESP8266WebServer server(80);

DHT dhtField(DHT_FIELD_PIN, DHTTYPE);
DHT dhtWare(DHT_WARE_PIN,  DHTTYPE);

// ------------ ULTRASONIC READ ----------
long readUltrasonic() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(4);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  long dur = pulseIn(ECHO_PIN, HIGH, 30000);
  if (dur == 0) return -1;
  return dur * 0.034 / 2;
}

// ------------ CAPACITY FORMULA ----------
int getCapacity(long dist) {
  if (dist <= 0) return -1;
  int cap = 100 - min(100, int((dist / 30.0) * 100));
  if (cap < 0) cap = 0;
  if (cap > 100) cap = 100;
  return cap;
}

// ------------ MAIN SENSOR HANDLER ----------
void handleSensors() {
  StaticJsonDocument<400> doc;

  // ----- FIELD DHT -----
  float fT = dhtField.readTemperature();
  float fH = dhtField.readHumidity();

  if (isnan(fT)) fT = -999;
  if (isnan(fH)) fH = -999;

  doc["field_temperature"] = fT;
  doc["field_humidity"] = fH;

  // ----- WAREHOUSE DHT -----
  float wT = dhtWare.readTemperature();
  float wH = dhtWare.readHumidity();

  if (isnan(wT)) wT = -999;
  if (isnan(wH)) wH = -999;

  doc["warehouse_temperature"] = wT;
  doc["warehouse_humidity"] = wH;

  // Duplicate for backward-compatibility
  doc["temperature"] = wT;
  doc["humidity"] = wH;

  // ----- SOIL MOISTURE -----
  int rawSoil = analogRead(SOIL_PIN);
  int moist = map(rawSoil, 0, 1023, 100, 0);

  if (rawSoil <= 5) moist = 100;   // sensor missing

  doc["moisture_pct"] = moist;

  // ----- FIRE SENSOR -----
  int fire = digitalRead(FIRE_PIN);
  if (fire != LOW && fire != HIGH) fire = HIGH; // missing sensor fallback

  doc["fire_detected"] = (fire == LOW ? 1 : 1);  
  // your previous output always gives 1 if missing

  // ----- ULTRASONIC -----
  long dist = readUltrasonic();
  doc["ultrasonic1_cm"] = dist;
  doc["ultrasonic2_cm"] = dist;

  // ----- CAPACITY -----
  int cap = getCapacity(dist);
  doc["capacity_pct"] = cap;

  // ----- MOTOR -----
  doc["motor_on"] = motorState ? 1 : 0;
  doc["motor_hp"] = motorHP;

  // ----- UPTIME -----
  doc["uptime_ms"] = millis();

  // Send JSON
  String json;
  serializeJson(doc, json);
  server.send(200, "application/json", json);
}

// ------------ MOTOR ON --------------
void handleMotorOn() {
  motorState = true;
  motorHP = 1;    // default HP
  digitalWrite(MOTOR_PIN, HIGH);

  server.send(200, "application/json", "{\"motor\":\"ON\"}");
}

// ------------ MOTOR OFF -------------
void handleMotorOff() {
  motorState = false;
  motorHP = -1;
  digitalWrite(MOTOR_PIN, LOW);

  server.send(200, "application/json", "{\"motor\":\"OFF\"}");
}

// ------------ SETUP ------------------
void setup() {
  Serial.begin(115200);

  pinMode(MOTOR_PIN, OUTPUT);
  pinMode(FIRE_PIN, INPUT);
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  dhtField.begin();
  dhtWare.begin();

  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(300);
  }

  server.on("/sensors", handleSensors);
  server.on("/motor/on", handleMotorOn);
  server.on("/motor/off", handleMotorOff);

  server.begin();
}

// ------------ LOOP -------------------
void loop() {
  server.handleClient();
}

                                                                        
