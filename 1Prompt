<script>
document.addEventListener("DOMContentLoaded", () => {
  const messages = document.getElementById("aura-chat-messages");
  const input = document.getElementById("aura-chat-input");
  const sendBtn = document.getElementById("aura-chat-send");

  function scrollBottom() { messages.scrollTop = messages.scrollHeight; }
  function addUser(msg) {
    messages.innerHTML += `<div class="user">${escapeHTML(msg)}</div>`;
    scrollBottom();
  }
  function addBot(msg) {
    messages.innerHTML += `<div class="bot">${msg}</div>`;
    scrollBottom();
  }
  function addTyping() {
    messages.innerHTML += `<div class="bot typing">AURA is thinking...</div>`;
    scrollBottom();
  }
  function removeTyping() {
    const t = document.querySelector(".typing");
    if (t) t.remove();
  }
  function escapeHTML(str) {
    return str.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  }

  setTimeout(() => addBot("Hi, I’m <b>AURA 🌾</b> — your smart agriculture assistant.<br>How can I help you today?"), 500);

  async function sendMessage() {
    const text = input.value.trim();
    if (!text) return;
    addUser(text);
    input.value = "";
    addTyping();

    const reply = await fetchReply(text);
    removeTyping();
    addBot(reply);
  }

  async function fetchReply(userMessage) {
    try {
      const res = await fetch("chatbot_api.php", {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: JSON.stringify({message: userMessage})
      });
      const data = await res.json();
      return data.reply || "⚠️ No reply received.";
    } catch {
      return "⚠️ Unable to connect to AURA server.";
    }
  }

  sendBtn.addEventListener("click", sendMessage);
  input.addEventListener("keypress", (e) => { if (e.key === "Enter") sendMessage(); });
});
</script>
