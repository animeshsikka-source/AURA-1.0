<style>
/* 🌾 AURA Chatbot – Compact Modern Design */
#chatbot-container {
  position: fixed;
  bottom: 18px;
  right: 18px;
  width: 270px;
  height: 370px;
  background: rgba(15, 30, 15, 0.95);
