<script>
document.addEventListener("DOMContentLoaded", () => {
  const messages = document.getElementById("chat-messages");
  const input = document.getElementById("chat-input");
  const sendBtn = document.getElementById("chat-send");

  if (!messages || !input || !sendBtn) return;

  // 👋 Welcome message
  setTimeout(() => {
    addBotMessage("Hi, I’m <b>AURA 🌾</b> — your smart agriculture assistant.<br>How can I help you today?");
  }, 500);

  // Send on button click
  sendBtn.addEventListener("click", handleSend);
  // Send on Enter
  input.addEventListener("keypress", (e) => { if (e.key === "Enter") handleSend(); });

  async function handleSend() {
    const text = input.value.trim();
    if (!text) return;
    addUserMessage(text);
    input.value = "";
    addTyping();

    const allData = await getAllDashboardData();
    const reply = await sendToAURA(text, allData);

    removeTyping();
    addBotMessage(reply);
  }

  // 🧠 Fetch all dashboard data
  async function getAllDashboardData() {
    const endpoints = ["get_data.php", "warehouse_data.php", "market_data.php"];
    const all = {};
    for (const url of endpoints) {
      try {
        const r = await fetch(url);
        all[url.replace(".php", "")] = await r.json();
      } catch { all[url.replace(".php", "")] = "⚠️ No data"; }
    }
    return all;
  }

  // 🔗 Send to backend
  async function sendToAURA(msg, data) {
    try {
      const res = await fetch("chatbot_api.php", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ message: msg, allData: data })
      });
      const json = await res.json();
      return json.reply;
    } catch {
      return "⚠️ Connection error with AURA server.";
    }
  }

  // 🪴 Helpers
  function addUserMessage(t) {
    messages.insertAdjacentHTML("beforeend", `<div class="user">${escapeHTML(t)}</div>`);
    scrollToBottom();
  }
  function addBotMessage(t) {
    messages.insertAdjacentHTML("beforeend", `<div class="bot">${t}</div>`);
    scrollToBottom();
  }
  function addTyping() {
    messages.insertAdjacentHTML("beforeend", `<div class="bot typing">AURA is thinking...</div>`);
    scrollToBottom();
  }
  function removeTyping() {
    const t = document.querySelector(".typing");
    if (t) t.remove();
  }
  function scrollToBottom() {
    messages.scrollTop = messages.scrollHeight;
  }
  function escapeHTML(str) {
    return str.replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]));
  }
});
</script>



