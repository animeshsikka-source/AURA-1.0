/* ==========================================================
   🌾 AURA Smart Agriculture — DARK GREEN GLASS THEME v5.0
   Designed for Index, Field_Crops, Warehouse & Market Dashboards
   ========================================================== */

:root {
  --bg: #0b1310;
  --card-bg: rgba(22, 30, 25, 0.85);
  --glass-border: rgba(255, 255, 255, 0.08);
  --text-light: #e2e8f0;
  --text-muted: #94a3b8;
  --accent-green: #22c55e;
  --accent-blue: #38bdf8;
  --accent-yellow: #facc15;
  --accent-red: #ef4444;
  --accent-orange: #fb923c;
  --radius: 16px;
  --shadow: 0 8px 20px rgba(0,0,0,0.5);
  --transition: all 0.3s ease;
  --gradient-green: linear-gradient(145deg, #14532d, #064e3b);
}

/* ---------- GLOBAL ---------- */
body {
  font-family: "Inter", "Segoe UI", sans-serif;
  background: var(--bg);
  margin: 0;
  padding: 0;
  color: var(--text-light);
  overflow-x: hidden;
}

h1, h2, h3 {
  color: var(--accent-green);
  font-weight: 700;
  margin-bottom: 10px;
}

p, li {
  color: var(--text-muted);
  line-height: 1.6;
}

ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

/* ---------- HEADER ---------- */
header {
  background: rgba(18, 24, 21, 0.9);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--glass-border);
  padding: 18px 30px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 10;
