  background: var(--accent-green);
  width: 0%;
  transition: width 0.5s ease;
}

.big {
  font-size: 1.8rem;
  font-weight: 700;
  color: #fff;
}

/* ---------- STATUS ---------- */
.status-box {
  padding: 8px 10px;
  border-radius: 10px;
  text-align: center;
  font-weight: 600;
  background: rgba(255,255,255,0.08);
