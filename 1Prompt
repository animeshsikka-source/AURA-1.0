<script>
document.addEventListener("DOMContentLoaded", () => {
  const API_URL = "get_latest.php";

  const refs = {
    connText: document.getElementById("connText"),
    fieldMoist: document.getElementById("fieldMoist"),
    moistAnim: document.getElementById("moistAnim"),
    fieldTemp: document.getElementById("fieldTemp"),
    fieldHum: document.getElementById("fieldHum"),
    flowRate: document.getElementById("flowRate"),
    wateringTime: document.getElementById("wateringTime"),
    growthBar: document.getElementById("growthBar"),
    harvestDays: document.getElementById("harvestDays"),
    yieldEl: document.getElementById("expectedYield"),
    phaseBar: document.getElementById("phaseBar"),
    fertList: document.getElementById("fertList")
  };

  const cropSchedules = {
    wheat: ["Day 0–15: Basal fertilizer (DAP + urea)",
            "Day 30–45: Top dressing (urea + potash)",
            "Day 70–80: Zinc + micronutrients"],
    rice: ["Day 0–20: Basal fertilizer (urea + DAP)",
           "Day 40–60: Tillering fertilizer dose",
           "Day 80–100: Potash & micro before panicle"],
    maize: ["Day 0–10: Basal DAP + urea",
            "Day 30–50: Nitrogen boost",
            "Day 70–90: Micronutrient spray"],
    pulses: ["Day 0–15: Organic manure",
             "Day 25–45: Bio-fertilizer dose",
             "Day 60–70: Foliar micro spray"],
    vegetables: ["Day 0–10: Compost + starter fertilizer",
                 "Day 20–40: NPK foliar mix weekly",
                 "Day 60+: Potash for yield"]
  };

  let selectedCrop = null;
  let sowingDate = null;
  let growthPercent = 0;

  async function loadCropData() {
    try {
      const res = await fetch("get_crop_data.php");
      const data = await res.json();
      if (data.crop) {
        document.getElementById("cropSelect").value = data.crop;
        document.getElementById("sowingDate").value = data.sowing_date;
        selectedCrop = data.crop;
        sowingDate = new Date(data.sowing_date);
        updateFertilizerSchedule();
      }
    } catch (err) {
      console.warn("No saved crop data.");
    }
  }

  document.getElementById("saveCrop").addEventListener("click", async () => {
    const crop = document.getElementById("cropSelect").value;
    const date = document.getElementById("sowingDate").value;
    if (!crop || !date) return alert("Please select crop and sowing date!");
    await fetch(`save_crop_data.php?crop=${crop}&sowing_date=${date}`);
    alert("✅ Crop data saved!");
    selectedCrop = crop;
    sowingDate = new Date(date);
    updateFertilizerSchedule();
  });

  function updateFertilizerSchedule() {
    if (!selectedCrop || !sowingDate) return;
    const today = new Date();
    const diffDays = Math.floor((today - sowingDate) / (1000 * 60 * 60 * 24));
    const schedule = cropSchedules[selectedCrop] || [];
    refs.fertList.innerHTML = schedule.map((s, i) => `<li>Phase ${i + 1}: ${s}</li>`).join("");
    const progress = Math.min(100, (diffDays / 100) * 100);
    refs.phaseBar.style.width = progress + "%";
    refs.growthBar.style.width = progress + "%";
    const remain = Math.max(0, 100 - diffDays);
    refs.harvestDays.textContent = `${remain} days remaining`;
    refs.yieldEl.textContent = `${(progress / 100 * 80).toFixed(1)} kg`;
  }

  document.getElementById("startMotor").addEventListener("click", async () => {
    const hp = parseInt(document.getElementById("motorHP").value);
    await fetch(`motor_on.php?hp=${hp}`);
    alert("🚿 Irrigation Started");
  });

  document.getElementById("stopMotor").addEventListener("click", async () => {
    await fetch("motor_off.php");
    alert("⛔ Irrigation Stopped");
  });

  document.getElementById("calcBtn").addEventListener("click", () => {
    const hp = parseFloat(document.getElementById("motorHP").value);
    const area = parseFloat(document.getElementById("fieldArea").value);
    const rate = hp * 15;
    const litres = area * 0.04;
    const mins = litres / rate;
    refs.flowRate.textContent = `${rate.toFixed(1)} L/min`;
    refs.wateringTime.textContent = `${mins.toFixed(1)} mins`;
  });

  async function fetchFieldData() {
    try {
      const res = await fetch(API_URL);
      const json = await res.json();
      if (json.esp) {
        const d = json.esp;
        refs.connText.textContent = "Connected ✅";
        refs.fieldMoist.textContent = `${d.moisture_pct}%`;
        refs.moistAnim.style.width = `${d.moisture_pct}%`;
        refs.fieldTemp.textContent = `${d.temperature.toFixed(1)} °C`;
        refs.fieldHum.textContent = `${d.humidity.toFixed(0)} %`;
      }
      updateFertilizerSchedule();
    } catch {
      refs.connText.textContent = "Offline ❌";
    }
  }

  async function loadFieldAI() {
    try {
      const res = await fetch('field_intelligence.php');
      const data = await res.json();
      document.getElementById('risk-value').textContent = data.pest_risk + "%";
      const riskEl = document.getElementById('risk-level');
      riskEl.textContent = "(" + data.risk_level + ")";
      riskEl.className = data.risk_level.toLowerCase();

      const irrigationEl = document.getElementById('irrigation-status');
      irrigationEl.textContent = data.irrigation_status;
      irrigationEl.className = 
        data.irrigation_status.includes("Safe") ? "safe" :
        data.irrigation_status.includes("Paused") ? "paused" : "active";

      document.getElementById('checkup-time').textContent = data.next_checkup;
      const alertEl = document.getElementById('weather-alert');
      if (data.alert) {
        alertEl.textContent = data.alert;
        alertEl.classList.add("active");
      } else {
        alertEl.textContent = "--";
        alertEl.classList.remove("active");
      }
    } catch (err) {
      console.error('AI Field error:', err);
    }
  }

  loadCropData();
  fetchFieldData();
  setInterval(fetchFieldData, 8000);
  loadFieldAI();
  setInterval(loadFieldAI, 300000);
});
</script>
</body>
</html>




